def test_grade(score):
    if score >= 90:
        return "Grade A"
    elif score >= 75:
        return "Grade B"
    elif score >= 60:
        return "Grade C"
    else:
        return "Grade F"

def main():
    println("--- Testing Control Flow & Grades ---")
    g1 = test_grade(95)
    g2 = test_grade(82)
    g3 = test_grade(65)
    g4 = test_grade(40)

    println("Score 95 -> " + g1)
    println("Score 82 -> " + g2)
    println("Score 65 -> " + g3)
    println("Score 40 -> " + g4)

    println("--- Testing Dynamic Reassignment ---")
    x = 100
    println("x as int: " + x)
    x = "Now x is a dynamic string!"
    println("x as string: " + x)

    println("--- Testing Lists & Indexing ---")
    items = [10, 20, 30, 40]
    println("Full list: " + items)
    first = items[0]
    third = items[2]
    println("items[0] = " + first)
    println("items[2] = " + third)
